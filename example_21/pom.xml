<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!--
	    PARENT : Spring Boot BOM (Bill of Materials)
	    Centralise les versions de toutes les dépendances Spring Boot.
	    Il suffit de déclarer spring-boot-starter-parent comme parent
	    pour bénéficier des versions compatibles sans les préciser manuellement.
	-->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.1.2</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

	<!-- Coordonnées Maven du projet -->
	<groupId>com.eazybytes</groupId>
	<artifactId>example_21</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>example_21</name>
	<description>Mini projet CRUD Spring Boot – Gestion de Produits (exemple pédagogique)</description>

	<properties>
		<java.version>17</java.version>
	</properties>

	<dependencies>

		<!--
		    spring-boot-starter-web
		    Inclut : Spring MVC, Tomcat embarqué, Jackson (JSON).
		    Permet de créer des API REST et d'exposer un serveur HTTP
		    sans configuration externe.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!--
		    spring-boot-starter-data-jpa
		    Inclut : Hibernate (ORM), Spring Data JPA.
		    Permet de mapper des classes Java en tables SQL et
		    de faire des opérations CRUD via des interfaces Repository.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!--
		    h2
		    Base de données relationnelle embarquée (en mémoire).
		    Idéale pour les tests et les démos : aucune installation requise.
		    Les données sont perdues à chaque redémarrage (scope runtime).
		-->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!--
		    spring-boot-starter-test
		    Inclut : JUnit 5, Mockito, Spring Test.
		    Utilisé uniquement pour les tests (scope test).
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

	</dependencies>

	<build>
		<plugins>
			<!--
			    spring-boot-maven-plugin
			    Permet de lancer l'application avec : mvn spring-boot:run
			    et de créer un JAR exécutable avec : mvn package
			-->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
